        }
      }
    },
    "/api/v1/auth/me/avatar": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Upload Avatar",
        "description": "Replace the caller's avatar.\n\nThe previous object is left in place rather than deleted: its key is content\naddressed, so a client showing the old URL keeps working until it refetches, and\nthe digest key means a revert to a previous image is free.",
        "operationId": "upload_avatar_api_v1_auth_me_avatar_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_avatar_api_v1_auth_me_avatar_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Delete Avatar",
        "description": "Remove the caller's avatar. Idempotent: a second call is also 204.",
        "operationId": "delete_avatar_api_v1_auth_me_avatar_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
