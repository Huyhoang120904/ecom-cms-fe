    "/api/v1/auth/deactivate": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Deactivate",
        "description": "Retire the account, confirmed by its password. One-way.",
        "operationId": "deactivate_api_v1_auth_deactivate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeactivateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
