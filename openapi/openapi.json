              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_avatar_api_v1_auth_me_avatar_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_avatar_api_v1_auth_me_avatar_post"
      },
      "Body_upload_background_api_v1_shops_active_background_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_background_api_v1_shops_active_background_post"
      },
      "DeactivateRequest": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "DeactivateRequest",
        "description": "Deactivating is one-way, so it is confirmed with the password."
      },
      "DeleteShopRequest": {
        "properties": {
          "confirm_shop_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Confirm Shop Name"
          }
        },
        "type": "object",
        "required": [
          "confirm_shop_name"
        ],
        "title": "DeleteShopRequest",
        "description": "Deleting a shop is one-way, so the shop's own name must be typed."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LivenessEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LivenessResponse"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "LivenessEnvelope"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "LivenessResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "description": "Sign in.\n\n``password`` is deliberately not length-validated beyond the request bound: a\nwrong password must reach the comparison and fail identically whether it is\nshort or long, or the response would disclose the stored password's length."
      },
      "MeData": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserData"
          },
          "active_shop": {
            "$ref": "#/components/schemas/ShopData"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/MembershipData"
            },
            "type": "array",
            "title": "Memberships"
          },
          "permissions": {
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "type": "array",
            "title": "Permissions"
          }
        },
        "type": "object",
        "required": [
          "user",
          "active_shop",
          "memberships",
          "permissions"
        ],
        "title": "MeData",
        "description": "The caller's own identity and the shop the token is scoped to."
      },
      "MeEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MeData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "MeEnvelope"
      },
      "MembershipData": {
        "properties": {
          "shop": {
            "$ref": "#/components/schemas/ShopData"
          },
          "role": {
            "$ref": "#/components/schemas/RoleData"
          }
        },
        "type": "object",
        "required": [
          "shop",
          "role"
        ],
        "title": "MembershipData",
        "description": "One shop the account belongs to, with the role it holds there."
      },
      "ProfileUpdateRequest": {
        "properties": {
          "full_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "bio": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "job_title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Title"
          }
        },
        "type": "object",
        "title": "ProfileUpdateRequest",
        "description": "A partial update of the caller's own profile.\n\nAn omitted key is unchanged; an explicit ``null`` clears a nullable field.\n``full_name`` may not be cleared, because it is not nullable in the database."
      },
      "ReadinessEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReadinessResponse"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "ReadinessEnvelope"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "not_ready"
            ],
            "title": "Status"
          },
          "dependencies": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ok",
                "unavailable"
              ]
            },
            "propertyNames": {
              "enum": [
                "database",
                "redis"
              ]
            },
            "type": "object",
            "title": "Dependencies"
          }
        },
        "type": "object",
        "required": [
          "status",
          "dependencies"
        ],
        "title": "ReadinessResponse"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          },
          "full_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Full Name"
          },
          "shop_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Shop Name"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "full_name",
          "shop_name"
        ],
        "title": "RegisterRequest",
        "description": "Create an account and its first shop in one call."
      },
      "RoleData": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 64,
            "title": "Key"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "key",
          "name"
        ],
        "title": "RoleData"
      },
      "SessionData": {
        "properties": {
          "access_token": {
            "type": "string",
            "maxLength": 4096,
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "user": {
            "$ref": "#/components/schemas/UserData"
          },
          "active_shop": {
            "$ref": "#/components/schemas/ShopData"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/MembershipData"
            },
            "type": "array",
            "title": "Memberships"
          },
          "permissions": {
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "type": "array",
            "title": "Permissions"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "user",
          "active_shop",
          "memberships",
          "permissions"
        ],
        "title": "SessionData",
        "description": "A successful sign-in.\n\nThe refresh token is *not* here. It travels only as an httpOnly cookie, so it\nnever appears in a response body, a log, or a client's memory."
      },
      "SessionEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SessionData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "SessionEnvelope"
      },
      "ShopData": {
