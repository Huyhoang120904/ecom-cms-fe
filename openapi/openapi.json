      },
      "patch": {
        "tags": [
          "shops"
        ],
        "summary": "Update Active Shop",
        "description": "Update the active shop's profile. The slug is not part of the contract.",
        "operationId": "update_active_shop_api_v1_shops_active_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShopUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
