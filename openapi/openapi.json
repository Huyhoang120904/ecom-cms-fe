        }
      }
    },
    "/api/v1/shops/active": {
      "delete": {
        "tags": [
          "shops"
        ],
        "summary": "Delete Active Shop",
        "description": "Retire the shop. Confirmed by its own name, read from the database.",
        "operationId": "delete_active_shop_api_v1_shops_active_delete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteShopRequest"
              }
            }
